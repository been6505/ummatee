rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── แอดมินตัวจริงเท่านั้น ──
    // ต้องล็อกอิน และอีเมลต้องอยู่ใน allowlist นี้
    // (แค่ "ล็อกอิน" ไม่พอ เพราะใครก็สมัครบัญชี Firebase เองได้)
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email in [
          'ummatee.thailand@gmail.com'
        ];
    }

    // ── ตรวจรูปแบบฟอร์มลงทะเบียน Iftar กันสแปม/เอกสารขยะ ──
    // จำกัดจำนวนฟิลด์ และให้ฟิลด์สำคัญเป็น string ความยาวสมเหตุสมผล
    function validIftarReg() {
      let d = request.resource.data;
      return d.size() <= 16
        && d.fname is string && d.fname.size() > 0 && d.fname.size() <= 100
        && d.lname is string && d.lname.size() > 0 && d.lname.size() <= 100
        && d.phone is string && d.phone.size() > 0 && d.phone.size() <= 20
        && (!('email' in d) || (d.email is string && d.email.size() <= 200))
        && (!('comment' in d) || (d.comment is string && d.comment.size() <= 1000))
        && (!('province' in d) || (d.province is string && d.province.size() <= 100));
    }

    // ลงทะเบียน Iftar — ส่งฟอร์มได้ทุกคน (มีการตรวจรูปแบบ) แต่อ่าน/แก้/ลบเฉพาะแอดมิน
    match /iftarRegs/{id} {
      allow create: if validIftarReg();
      allow read, update, delete: if isAdmin();
    }

    // ค่า config สาธารณะ (เช่น ยอดกุรบาน) — ทุกคนอ่านได้ แก้ได้เฉพาะแอดมิน
    match /config/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // บันทึกเงินบริจาค — เฉพาะแอดมิน
    match /donations/{id} {
      allow read, write: if isAdmin();
    }

    // แผนคอนเทนต์/ปฏิทินโพสต์ — เฉพาะแอดมิน
    match /contentPosts/{id} {
      allow read, write: if isAdmin();
    }

    // สินค้า Um Shop — ทุกคนอ่านได้ (หน้า /um-shop) แก้ไขได้เฉพาะแอดมิน
    match /products/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // อาสาสมัคร — ส่งฟอร์มได้ทุกคน อ่าน/แก้/ลบเฉพาะแอดมิน
    match /volunteerRegs/{id} {
      allow create: if request.resource.data.fname is string && request.resource.data.fname.size() > 0
        && request.resource.data.lname is string && request.resource.data.lname.size() > 0
        && request.resource.data.phone is string && request.resource.data.phone.size() > 0;
      allow read, update, delete: if isAdmin();
    }

    // Give2 — ส่งต่อของงาน "ให้" ครั้งที่ 6
    match /give2Regs/{id} {
      allow create: if request.resource.data.fname is string && request.resource.data.fname.size() > 0
        && request.resource.data.lname is string && request.resource.data.lname.size() > 0
        && request.resource.data.phone is string && request.resource.data.phone.size() > 0
        && request.resource.data.types is list && request.resource.data.types.size() > 0;
      allow read, update, delete: if isAdmin();
    }

    // counter สำหรับ give2 ref code
    match /config/give2Counter {
      allow read, write: if true;
    }

    // สถิติหน้าบริจาค — จำกัดเฉพาะ doc 'donation' และ field ต้องเป็นตัวเลข
    match /stats/donation {
      allow create, update: if request.resource.data.keys().hasOnly(['views','copies'])
        || request.resource.data.keys().hasAny(['views','copies']);
      allow read: if isAdmin();
    }

    // ปฏิเสธทุกอย่างที่ไม่ได้ระบุไว้ข้างบน
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
