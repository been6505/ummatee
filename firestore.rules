rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ลงทะเบียน Iftar — ทุกคนส่งฟอร์มได้ แต่อ่าน/แก้/ลบได้เฉพาะ admin ที่ล็อกอิน
    match /iftarRegs/{id} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }

    // ค่า config สาธารณะ (เช่น ยอดกุรบาน) — ทุกคนอ่านได้ แก้ได้เฉพาะ admin
    match /config/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // บันทึกเงินบริจาค — เฉพาะ admin
    match /donations/{id} {
      allow read, write: if request.auth != null;
    }

    // แผนคอนเทนต์/ปฏิทินโพสต์ — เฉพาะ admin
    match /contentPosts/{id} {
      allow read, write: if request.auth != null;
    }

    // รายรับ-รายจ่ายส่วนตัว — เจ้าของข้อมูลเท่านั้นที่อ่าน/แก้ได้ (แยกตาม uid)
    match /moneyTx/{id} {
      allow read, update, delete: if request.auth != null && resource.data.uid == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
    }

    // ตั้งค่าเงินเดือน/ค่าใช้จ่ายคงที่ — 1 เอกสารต่อผู้ใช้ ใช้ uid เป็นชื่อเอกสาร
    match /moneySettings/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
