rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── แอดมินตัวจริงเท่านั้น ──
    // ต้องล็อกอิน และอีเมลต้องอยู่ใน allowlist นี้
    // (แค่ "ล็อกอิน" ไม่พอ เพราะใครก็สมัครบัญชี Firebase เองได้)
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email in [
          'akasitlove@gmail.com',
          'ummatee.thailand@gmail.com',
          'ummatee.volunteer@gmail.com'
        ];
    }

    // ── แอดมินตัวจริง ไม่รวมบัญชีอาสาสมัคร ──
    // ใช้กับคอลเลกชันที่หน้าซึ่งอาสาสมัครเข้าถึงได้ (/admin/dashboard, /admin/event/iftar2026,
    // /admin/qrcode, /admin/give — ดู VOLUNTEER_ALLOWED ใน src/useAdminRole.js) ไม่จำเป็นต้องใช้
    // เช่น ยอดเงินบริจาครายรายการ, แผนคอนเทนต์, ข้อมูล PII ของอาสาสมัคร/ร้านค้า B2UM คนอื่น
    // เพราะบัญชี ummatee.volunteer@gmail.com ตั้งใจให้แชร์กับทีมอาสาสมัครกลุ่มกว้าง ความน่าเชื่อถือ
    // ต่ำกว่าแอดมินตัวจริง จึงไม่ควรเข้าถึงข้อมูลนอกขอบเขตหน้าที่ได้ผ่าน Firestore SDK โดยตรง
    function isFullAdmin() {
      return request.auth != null
        && request.auth.token.email in [
          'akasitlove@gmail.com',
          'ummatee.thailand@gmail.com'
        ];
    }

    // ── helper: ฟิลด์ optional ถ้ามีต้องเป็น string ไม่เกินความยาวที่กำหนด ──
    function optStr(d, k, max) {
      return !(k in d) || (d[k] is string && d[k].size() <= max);
    }

    // ── ตรวจรูปแบบฟอร์มลงทะเบียน Iftar กันสแปม/เอกสารขยะ ──
    // จำกัดจำนวนฟิลด์ + คุมความยาวทุกฟิลด์ (กันยัด junk ขนาดใหญ่เปลือง quota)
    function validIftarReg() {
      let d = request.resource.data;
      return d.size() <= 14
        && d.fname is string && d.fname.size() > 0 && d.fname.size() <= 100
        && d.lname is string && d.lname.size() > 0 && d.lname.size() <= 100
        && d.phone is string && d.phone.size() > 0 && d.phone.size() <= 20
        && optStr(d, 'email', 200)
        && optStr(d, 'comment', 1000)
        && optStr(d, 'province', 100)
        && optStr(d, 'gender', 30)
        && optStr(d, 'age', 10)
        && optStr(d, 'job', 100)
        && optStr(d, 'channel', 300)
        && optStr(d, 'expect', 300)
        && optStr(d, 'date', 60)
        && optStr(d, 'ref', 40);
    }

    // ลงทะเบียน Iftar — ส่งฟอร์มได้ทุกคน (มีการตรวจรูปแบบ) แต่อ่าน/แก้/ลบเฉพาะแอดมิน
    match /iftarRegs/{id} {
      allow create: if validIftarReg();
      allow read, update, delete: if isAdmin();
    }

    // ค่า config สาธารณะ (เช่น ยอดกุรบาน) — ทุกคนอ่านได้ แก้ได้เฉพาะแอดมิน
    match /config/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // บันทึกเงินบริจาค — เฉพาะแอดมินตัวจริง (ไม่ใช่ขอบเขตงานอาสาสมัคร)
    match /donations/{id} {
      allow read, write: if isFullAdmin();
    }

    // แผนคอนเทนต์/ปฏิทินโพสต์ — เฉพาะแอดมินตัวจริง (ฟิลด์โพสต์จริง realStatus/publishResults
    // ถูกเขียนจาก Cloud Functions ด้วย Admin SDK เท่านั้น แต่แอดมินยังแก้ไฟล์แผนผ่าน client ได้ตามปกติ)
    match /contentPosts/{id} {
      allow read, write: if isFullAdmin();
    }

    // บัญชีโซเชียลที่เชื่อมต่อ OAuth ไว้ (access/refresh token) — ห้ามฝั่ง client อ่าน/เขียนตรงเด็ดขาด
    // เขียนได้เฉพาะ Cloud Functions ผ่าน Admin SDK เท่านั้น (bypass rules อยู่แล้ว) หน้าเว็บต้องเรียกผ่าน
    // callable function (socialAccountsStatus) ที่กรอง token ออกก่อนส่งกลับ ไม่ใช่ query คอลเลกชันนี้ตรงๆ
    match /socialAccounts/{id} {
      allow read, write: if false;
    }

    // แคชผล Page/Account Insights ต่อแพลตฟอร์ม (socialGetPageInsights) — ไม่มี token อยู่ในนี้ (แค่ตัวเลข
    // เมทริก) แต่ยังคุมให้เขียนได้เฉพาะ Cloud Functions (Admin SDK bypass rules) เหมือน socialAccounts
    // และอ่านได้เฉพาะแอดมินตัวจริง (isFullAdmin) ให้สอดคล้อง contentPosts/socialAccounts ที่เป็นชุดข้อมูลเดียวกัน
    match /socialInsightsCache/{platform} {
      allow read: if isFullAdmin();
      allow write: if false;
    }

    // สินค้า Um Shop — ทุกคนอ่านได้ (หน้า /um-shop) แก้ไขได้เฉพาะแอดมินตัวจริง
    match /products/{id} {
      allow read: if true;
      allow create, delete: if isFullAdmin();
      // ตอนสั่งซื้อ (guest checkout ไม่ล็อกอิน) ต้องตัดสต็อกได้ — อนุญาตแก้ได้แค่ stock (รวม), sizeStock (แยกต่อไซซ์), sold (ยอดขายสะสม)
      // ห้ามเพิ่มสต็อก/ทำติดลบ (กันสั่งซื้อปลอมเพิ่มสต็อกให้ตัวเอง) และ sold ต้องเพิ่มขึ้นเสมอ (กันปั่นยอดขายลง) ฟิลด์อื่นแก้ได้เฉพาะแอดมิน
      // sizeStock ตรวจได้แค่ว่าเป็น map เท่านั้น (Firestore rules ตรวจ diff ของ map แบบละเอียดทำยาก) — พึ่ง invariant ของ stock รวมที่บังคับลดลงเสมอเป็นเกราะหลัก
      allow update: if isFullAdmin()
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock', 'sizeStock', 'sold'])
            && request.resource.data.stock is int
            && resource.data.stock is int
            && request.resource.data.stock >= 0
            && request.resource.data.stock < resource.data.stock
            && (!('sizeStock' in request.resource.data.diff(resource.data).affectedKeys()) || request.resource.data.sizeStock is map)
            // บั๊กเดิม: resource.data.sold is int พังทั้งเงื่อนไข (permission-denied ทั้ง write) ตอนสินค้าเก่าที่สร้างก่อนมีฟีเจอร์ sold
            // ไม่มีฟิลด์ sold เลย — Firestore rules error ทันทีที่เข้าถึงฟิลด์ที่ไม่มีอยู่แบบ dot notation โดยไม่ guard 'sold' in resource.data ก่อน
            // ทำให้สั่งซื้อสินค้าเก่าไม่ได้เลยทุกครั้ง (permission error ที่ดูเหมือนมาจากข้อมูลลูกค้า แต่จริงๆ มาจากจุดนี้)
            && (!('sold' in request.resource.data.diff(resource.data).affectedKeys())
                || (request.resource.data.sold is int
                    && request.resource.data.sold > (('sold' in resource.data && resource.data.sold is int) ? resource.data.sold : 0))));
    }

    // ประวัติการเคลื่อนไหวสต็อก Um Shop — บันทึกทุกครั้งที่ตัด/รับเข้า อ่านได้เฉพาะแอดมิน
    // guest checkout สร้างได้เฉพาะรายการ type 'order' ที่เป็นค่าติดลบ (ตัดสต็อก) เท่านั้น
    // ส่วนรับเข้าคลัง (stock-in) ต้องเป็นแอดมินเท่านั้น
    function validStockMovement() {
      let d = request.resource.data;
      return d.keys().hasOnly(['productId', 'productCode', 'productName', 'qty', 'type', 'reason', 'orderCode', 'at'])
        && d.productId is string && d.productId.size() > 0 && d.productId.size() <= 100
        && optStr(d, 'productCode', 30)
        && optStr(d, 'productName', 200)
        && d.qty is int && d.qty != 0 && d.qty >= -100000 && d.qty <= 100000
        && d.type in ['order', 'stock-in']
        && optStr(d, 'reason', 300)
        && optStr(d, 'orderCode', 20)
        && d.at is number;
    }
    match /stockMovements/{id} {
      allow create: if isFullAdmin()
        || (validStockMovement() && request.resource.data.type == 'order' && request.resource.data.qty < 0);
      allow read, list, update, delete: if isFullAdmin();
    }

    // โปรโมชั่นส่วนลด Um Shop — ใช้เฉพาะฝั่งแอดมินตอนตั้งราคาส่วนลด ไม่มีหน้าไหนฝั่งลูกค้าต้องอ่าน
    match /shopPromotions/{id} {
      allow read, write: if isFullAdmin();
    }

    // คำสั่งซื้อ Um Shop — สั่งซื้อได้โดยไม่ต้องล็อกอิน (guest checkout)
    // อ่านทีละรายการได้ทุกคน (เข้าผ่านลิงก์ติดตามคำสั่งซื้อที่เดา id ยาก) แต่ list ทั้งคอลเลกชันได้เฉพาะแอดมินตัวจริง
    function validOrderCreate() {
      let d = request.resource.data;
      return d.size() <= 9
        && d.orderCode is string && d.orderCode.size() <= 20
        && d.items is list && d.items.size() > 0 && d.items.size() <= 50
        && d.itemsTotal is number && d.itemsTotal >= 0
        && d.shippingFee is number && d.shippingFee >= 0
        && d.total is number && d.total == d.itemsTotal + d.shippingFee
        && d.customer is map
        // ฟอร์มเช็คเอาท์รวมช่องชื่อ-นามสกุลเป็นช่องเดียว (fullName) แล้ว แต่ยอมรับ firstName แบบเก่าด้วยชั่วคราว
        // (เผื่อเบราว์เซอร์ลูกค้าแคช JS เก่าค้างไว้ผ่าน PWA service worker ยังไม่รีเฟรชมาใช้ฟอร์มใหม่ —
        // ถ้าบังคับ fullName อย่างเดียวทันที ลูกค้าที่ค้าง JS เก่าจะสั่งซื้อไม่ได้เลยเงียบๆ ด้วย permission error)
        && (
          (d.customer.fullName is string && d.customer.fullName.size() > 0 && d.customer.fullName.size() <= 200)
          || (d.customer.firstName is string && d.customer.firstName.size() > 0 && d.customer.firstName.size() <= 100)
        )
        && d.customer.phone is string && d.customer.phone.size() > 0 && d.customer.phone.size() <= 20
        && optStr(d.customer, 'email', 200)
        && d.customer.address is string && d.customer.address.size() > 0 && d.customer.address.size() <= 500
        && d.status == 'pending_payment'
        && d.paymentProofUrl == null
        && d.createdAt is number;
    }
    match /orders/{id} {
      allow create: if validOrderCreate();
      allow get: if true;
      allow list: if isFullAdmin();
      // แอดมินตัวจริงแก้ไขได้ทุกฟิลด์ (เปลี่ยนสถานะ/แนบรูปแพ็ค/อัปเดตการจัดส่ง) — ลูกค้าแก้ได้ 2 เคส (เฉพาะตอนยังไม่ยืนยันจ่ายเงิน):
      allow update: if isFullAdmin()
        || (resource.data.status == 'pending_payment'
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['paymentProofUrl', 'paymentProofAt', 'paymentDeclaredAt']));
      allow delete: if isFullAdmin();
    }

    // ตัวนับเลขที่คำสั่งซื้อ ORD-0001, ORD-0002, ... — อนุญาตเพิ่มทีละ 1 เท่านั้น
    match /config/shopOrderCounter {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['count'])
        && request.resource.data.count == 1;
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['count'])
        && request.resource.data.count == resource.data.count + 1;
    }

    // อาสาสมัคร — Firestore เป็นที่เก็บหลัก (ส่งฟอร์มได้ทุกคน) อ่าน/ลบเฉพาะแอดมิน
    // ใช้ hasOnly() ระบุฟิลด์ที่อนุญาตแบบเป๊ะ (ไม่ใช่แค่นับจำนวน) กันฟิลด์แปลกปลอมหลุดเข้ามา
    // และคุมความยาวทุกฟิลด์ที่เคยไม่ได้เช็ค (type/token/date/gender/channel/ref)
    function validVolunteerReg() {
      let d = request.resource.data;
      return d.keys().hasOnly([
          'ref', 'type', 'token', 'date', 'fname', 'lname', 'fnameEn', 'lnameEn',
          'phone', 'email', 'age', 'gender', 'province', 'channel', 'expect',
          'skills', 'missions', 'giveProjects', 'giveDates', 'note',
          'sheetSynced', 'syncAttempts'
        ])
        && d.fname is string && d.fname.size() > 0 && d.fname.size() <= 100
        && d.lname is string && d.lname.size() > 0 && d.lname.size() <= 100
        && d.phone is string && d.phone.size() > 0 && d.phone.size() <= 20
        && optStr(d, 'ref', 30)
        && optStr(d, 'type', 30)
        && optStr(d, 'token', 100)
        && optStr(d, 'date', 100)
        && optStr(d, 'fnameEn', 100)
        && optStr(d, 'lnameEn', 100)
        && optStr(d, 'email', 200)
        && optStr(d, 'age', 10)
        && optStr(d, 'gender', 20)
        && optStr(d, 'province', 100)
        && optStr(d, 'channel', 50)
        && optStr(d, 'expect', 1000)
        && optStr(d, 'skills', 1000)
        && optStr(d, 'missions', 1000)
        && optStr(d, 'giveProjects', 500)
        && optStr(d, 'giveDates', 500)
        && optStr(d, 'note', 1000)
        && (!('sheetSynced' in d) || d.sheetSynced is bool)
        && (!('syncAttempts' in d) || (d.syncAttempts is int && d.syncAttempts >= 0 && d.syncAttempts <= 20));
    }
    match /volunteerRegs/{id} {
      allow create: if validVolunteerReg();
      allow get, list, delete: if isFullAdmin();
      // แอดมินแก้ได้ทุกฟิลด์ — ใครก็ได้ (รวมเบราว์เซอร์ของผู้สมัครเอง) อัปเดตได้เฉพาะสถานะซิงก์ชีต
      // เท่านั้น (ไม่ใช่ PII) เพื่อให้ backup ไป Sheet สำเร็จ/ล้มเหลวแล้วอัปเดตกลับได้โดยไม่ต้องล็อกอิน
      allow update: if isFullAdmin()
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['sheetSynced', 'syncAttempts']);
    }

    // ตัวนับเลขอ้างอิงอาสาสมัคร UMV-0001, UMV-0002, ... (แยกจาก Sheet row เพื่อไม่ให้พึ่ง Apps Script)
    match /config/volunteerRefCounter {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['count'])
        && request.resource.data.count == 1;
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['count'])
        && request.resource.data.count == resource.data.count + 1;
    }

    // Give2 — ส่งต่อของงาน "ให้" ครั้งที่ 6 (คุมจำนวน+ความยาว+ขนาด list)
    function validGive2Reg() {
      let d = request.resource.data;
      return d.size() <= 14
        && d.fname is string && d.fname.size() > 0 && d.fname.size() <= 100
        && d.lname is string && d.lname.size() > 0 && d.lname.size() <= 100
        && d.phone is string && d.phone.size() > 0 && d.phone.size() <= 20
        && d.types is list && d.types.size() > 0 && d.types.size() <= 5
        && (!('imageUrls' in d) || (d.imageUrls is list && d.imageUrls.size() <= 10))
        && optStr(d, 'email', 200)
        && optStr(d, 'typeLabels', 300)
        && optStr(d, 'detail', 2000)
        && optStr(d, 'refCode', 40)
        && optStr(d, 'submittedAt', 60);
    }
    match /give2Regs/{id} {
      allow create: if validGive2Reg();
      allow read, update, delete: if isAdmin();
    }

    // Give2Cook — มอบเครื่องมือประกอบอาชีพ
    function validGive2CookReg() {
      let d = request.resource.data;
      return d.size() <= 12
        && d.fname is string && d.fname.size() > 0 && d.fname.size() <= 100
        && d.lname is string && d.lname.size() > 0 && d.lname.size() <= 100
        && d.phone is string && d.phone.size() > 0 && d.phone.size() <= 20
        && d.refCode is string && d.refCode.size() <= 20
        && d.types is list && d.types.size() > 0 && d.types.size() <= 10
        && (!('imageUrls' in d) || (d.imageUrls is list && d.imageUrls.size() <= 10))
        && optStr(d, 'email', 200)
        && optStr(d, 'detail', 2000)
        && optStr(d, 'typeLabels', 500)
        && optStr(d, 'submittedAt', 60);
    }
    match /give2CookRegs/{id} {
      allow create: if validGive2CookReg();
      allow read, update, delete: if isAdmin();
    }
    // ตัวนับ ref code — อนุญาตเพิ่มทีละ 1 เท่านั้น (ป้องกันการรีเซ็ตหรือข้ามค่า)
    match /config/give2CookCounter {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['count'])
        && request.resource.data.count == 1;
      allow update: if request.resource.data.keys().hasOnly(['count'])
        && request.resource.data.count == resource.data.count + 1;
    }

    // counter สำหรับ give2 ref code — อนุญาตเพิ่มทีละ 1 เท่านั้น
    match /config/give2Counter {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['count'])
        && request.resource.data.count == 1;
      allow update: if request.resource.data.keys().hasOnly(['count'])
        && request.resource.data.count == resource.data.count + 1;
    }

    // สถิติหน้าบริจาค — Firestore Rules ประเมิน request.resource.data.keys() ผิดพลาดเมื่อ field ที่แก้ไข
    // ใช้ FieldValue.increment() ร่วมกับ hasOnly() ที่มีมากกว่า 1 field ในลิสต์ (พิสูจน์แล้วด้วยการทดสอบเขียนจริง
    // — เขียนไม่ได้แม้ field/ข้อมูลถูกต้องทุกอย่าง) ต้องใช้ diff().affectedKeys() แทนสำหรับ update เพื่อเลี่ยงบั๊กนี้
    match /stats/donation {
      allow create: if request.resource.data.keys().hasOnly(['views', 'copies']);
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views', 'copies']);
      allow read: if isAdmin();
    }

    // สถิติหน้า Iftar — นับจำนวนกดคัดลอกเลขบัญชี
    match /stats/iftar {
      allow create, update: if request.resource.data.keys().hasOnly(['copies']);
      allow read: if isAdmin();
    }

    // นับผู้เข้าชมเว็บไซต์ — ทุกคนเพิ่มยอด views ได้ (เฉพาะ field views) แต่อ่านได้เฉพาะ admin
    match /stats/site {
      allow create, update: if request.resource.data.keys().hasOnly(['views']);
      allow read: if isAdmin();
    }

    // B2UM ร้านค้า — ส่งฟอร์มได้ทุกคน อ่าน/แก้/ลบเฉพาะแอดมิน
    match /b2umRegs/{id} {
      allow create: if request.resource.data.size() <= 8
        && request.resource.data.fname is string && request.resource.data.fname.size() <= 100
        && request.resource.data.lname is string && request.resource.data.lname.size() <= 100
        && request.resource.data.phone is string && request.resource.data.phone.size() <= 20
        && request.resource.data.shopName is string && request.resource.data.shopName.size() <= 200;
      allow read, update, delete: if isFullAdmin();
    }

    // Give Receive — ลงทะเบียนรับคอมมือสอง / อุปกรณ์ประกอบอาชีพ
    match /giveReceiveRegs/{id} {
      allow create: if request.resource.data.size() <= 13
        && request.resource.data.fname is string && request.resource.data.fname.size() <= 100
        && request.resource.data.lname is string && request.resource.data.lname.size() <= 100
        && request.resource.data.phone is string && request.resource.data.phone.size() <= 20
        && request.resource.data.type is string && request.resource.data.type.size() <= 20
        && optStr(request.resource.data, 'email', 200)
        && optStr(request.resource.data, 'address', 500)
        && optStr(request.resource.data, 'reason', 2000)
        && optStr(request.resource.data, 'wantedItems', 500);
      // อ่านทีละรายการ (สแกน QR RCV-{id}) และแก้เฉพาะ received/receivedAt ได้ทุกแอดมิน
      // แต่ list ทั้งคอลเลกชัน (ดึง PII ผู้รับทั้งหมดทีเดียว) และลบ เฉพาะแอดมินตัวจริง
      allow get: if isAdmin();
      allow list, delete: if isFullAdmin();
      allow update: if isFullAdmin()
        || (isAdmin()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['received', 'receivedAt']));
    }

    // มีเดียประจำภารกิจ — ทุกคนอ่านได้ (หน้า /missions) แก้ไขได้เฉพาะแอดมินตัวจริง
    match /missionMedia/{id} {
      allow read: if true;
      allow write: if isFullAdmin();
    }

    // แชทเว็บ — chatId คือ visitor id แบบสุ่มที่เก็บไว้ใน localStorage ของผู้เยี่ยมชม (ไม่ล็อกอิน)
    // get รายตัว (รู้ id ตรง) เปิดให้ทุกคน แต่ list ทั้งคอลเลกชัน (อ่านแชททุกคนพร้อมกัน) เฉพาะแอดมิน
    // ป้องกัน field แปลกปลอม/spam ด้วย hasOnly + จำกัดความยาว เหมือน collection อื่นๆ ในไฟล์นี้
    function validChatDoc() {
      let d = request.resource.data;
      return d.keys().hasOnly(['createdAt', 'lastMessageAt', 'lastMessageText', 'lastSender', 'unreadByAdmin', 'unreadByVisitor', 'visitorName'])
        && d.lastMessageText is string && d.lastMessageText.size() <= 2000
        && d.lastSender in ['visitor', 'admin']
        // ต้องเป็นแอดมินจริงถึงจะตั้ง lastSender เป็น 'admin' ได้ กัน user ทั่วไปปลอมข้อความว่ามาจากแอดมิน
        && (d.lastSender == 'visitor' || isAdmin())
        && d.unreadByAdmin is bool && d.unreadByVisitor is bool
        && optStr(d, 'visitorName', 100);
    }
    match /chats/{chatId} {
      allow get: if true;
      allow list: if isAdmin();
      allow create: if validChatDoc();
      // ฝั่งผู้เยี่ยมชมแก้ได้เฉพาะตอนส่งข้อความตัวเอง (lastSender ต้องเป็น visitor) แอดมินแก้ได้ทุกฟิลด์ (รวม unreadByAdmin ตอนกดอ่าน)
      allow update: if isAdmin() || (validChatDoc() && request.resource.data.lastSender == 'visitor');
      allow delete: if isAdmin();

      // การ์ดสินค้าที่แนบมากับข้อความ (กดปุ่ม "แชท" จากหน้ารายละเอียดสินค้า) — ไม่มี text ก็ได้ ถ้ามี product แทน
      // image/url ฝั่งแอดมินเอาไปเรนเดอร์ตรงๆ เป็น <img src>/<a href> (ดู AdminChat.jsx) — ต้องบังคับ http(s):// เท่านั้น
      // กัน visitor ปลอมข้อความ (เขียนตรงผ่าน Firestore SDK ข้าม UI) ยัด scheme อันตรายเช่น javascript: เข้ามาโจมตีแอดมินตอนคลิก
      function optHttpUrl(d, k, max) {
        return !(k in d) || (d[k] is string && d[k].size() <= max && d[k].matches('^https?://.+'));
      }
      function validProductCard() {
        let p = request.resource.data.product;
        return p.keys().hasOnly(['name', 'price', 'image', 'url'])
          && p.name is string && p.name.size() > 0 && p.name.size() <= 200
          && (!('price' in p) || p.price is number)
          && optHttpUrl(p, 'image', 500)
          && optHttpUrl(p, 'url', 500);
      }
      match /messages/{msgId} {
        allow get, list: if true;
        allow create: if request.resource.data.keys().hasOnly(['sender', 'text', 'createdAt', 'type', 'product'])
          && request.resource.data.sender in ['visitor', 'admin']
          // ต้องเป็นแอดมินจริงถึงจะส่งข้อความที่ sender: 'admin' ได้ ไม่งั้นใครก็ปลอมข้อความแอดมินได้
          // (อันตรายเพราะ onAdminReply ใน functions/index.js จะ push ข้อความ sender:'admin' ออกไปยัง LINE/Facebook จริงของผู้ใช้)
          && (request.resource.data.sender == 'visitor' || isAdmin())
          && (
            (!('type' in request.resource.data)
              && request.resource.data.text is string
              && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 2000)
            || (request.resource.data.type == 'product' && request.resource.data.sender == 'visitor' && validProductCard())
          );
        allow update, delete: if isAdmin();
      }
    }

    // ══════════════════════════════════════════════════════════════════
    // ── ระบบ Staff role ใหม่ (staff/{uid}) + CRM/บอร์ด/audit log ─────
    // เพิ่มใหม่ทั้งหมดตั้งแต่ตรงนี้ลงไป ไม่แตะ collection เดิมด้านบนเลย
    // ══════════════════════════════════════════════════════════════════

    // อ่าน role ของผู้ใช้ที่ล็อกอินอยู่เองจาก staff/{uid} แล้วเช็คว่าอยู่ใน roles ที่อนุญาต + ต้อง active
    function isStaffRole(roles) {
      return request.auth != null
        && exists(/databases/$(database)/documents/staff/$(request.auth.uid))
        && get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.active == true
        && get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.role in roles;
    }

    // staff/{uid} — doc id ต้องตรงกับ uid เจ้าของเสมอ
    match /staff/{staffId} {
      allow read: if request.auth != null && (request.auth.uid == staffId || isStaffRole(['admin']));
      // สมัครตัวเองครั้งแรก: สร้างได้เฉพาะ doc ตัวเอง และบังคับ role เป็น 'pending' เท่านั้น
      //
      // สำคัญ: ห้ามให้ default เป็น 'staff' เด็ดขาด — 'staff' มีสิทธิ์ read/write/delete ข้อมูล CRM ทั้งหมด
      // (partnerOrganizations/aidLocations/speakers/boards) ซึ่งมี PII ผู้ติดต่อและยอดเงินที่จ่ายวิทยากร
      // ถ้าใครสมัคร Firebase Auth ได้ก็จะได้สิทธิ์นั้นทันที ต่างจาก collection เดิมที่กันด้วย email allowlist
      // 'pending' ไม่อยู่ใน allowedRoles ของ collection ไหนเลย = เข้าอะไรไม่ได้จนกว่าแอดมินจะเลื่อน role ให้
      allow create: if request.auth != null && request.auth.uid == staffId
        && request.resource.data.role == 'pending'
        && request.resource.data.active == true;
      // แก้ไขข้อมูลตัวเอง (เช่น lastLoginAt) ได้ แต่ห้ามเปลี่ยน role/active ของตัวเอง (กัน self-elevate)
      // แอดมินแก้ของใครก็ได้ทุกฟิลด์ (ตั้ง role/active ให้คนอื่น)
      allow update: if isStaffRole(['admin'])
        || (request.auth.uid == staffId
            && request.resource.data.role == resource.data.role
            && request.resource.data.active == resource.data.active);
      allow delete: if isStaffRole(['admin']);
    }

    // CRM: องค์กรพันธมิตร / จุดลงพื้นที่ (แผนที่) / วิทยากร — admin, staff, field เข้าถึงได้
    match /partnerOrganizations/{id} {
      allow read, write: if isStaffRole(['admin', 'staff', 'field']);
    }
    match /aidLocations/{id} {
      allow read, write: if isStaffRole(['admin', 'staff', 'field']);
    }
    match /speakers/{id} {
      allow read, write: if isStaffRole(['admin', 'staff', 'field']);
    }

    // บอร์ดวางแผนสไตล์ Trello
    match /boards/{id} {
      allow read, write: if isStaffRole(['admin', 'staff', 'field']);
    }
    match /boardLists/{id} {
      allow read, write: if isStaffRole(['admin', 'staff', 'field']);
    }
    match /boardCards/{id} {
      allow read, write: if isStaffRole(['admin', 'staff', 'field']);
    }

    // Audit log — เขียนได้ทุก staff role ที่ยังมีสิทธิ์แก้ข้อมูล (เพื่อบันทึกการกระทำของตัวเอง)
    // แต่อ่าน (ดูประวัติทั้งหมด) ได้เฉพาะ admin เท่านั้น และห้ามแก้/ลบใครทั้งนั้น (append-only)
    match /auditLog/{id} {
      allow create: if isStaffRole(['admin', 'staff', 'field', 'social'])
        && request.resource.data.staffUid == request.auth.uid;
      allow read: if isStaffRole(['admin']);
      allow update, delete: if false;
    }

    // ══════════════════════════════════════════════════════════════════
    // ── Campaign / Event / campaignPartners (แผนแอดมิน-อินทราเน็ต ข้อ 2/3/6) ─
    // gating เดียวกับ CRM/บอร์ดด้านบน (admin/staff/field) ไม่แตะ collection เดิมเลย
    // ══════════════════════════════════════════════════════════════════

    // แคมเปญบริจาค — campaignId ที่ contentPosts/boardCards อ้างถึงเป็นแค่ string เชื่อมโยงฝั่ง client
    // (ไม่บังคับ referential integrity ใน rules เพราะ contentPosts/boardCards เขียนได้กว้างอยู่แล้ว)
    match /campaigns/{id} {
      allow read, write: if isStaffRole(['admin', 'staff', 'field']);
    }

    // งาน/อีเวนต์ทั่วไป (ยกระบบจาก Iftar ให้ใช้ซ้ำได้ทุกงาน)
    match /events/{id} {
      allow read, write: if isStaffRole(['admin', 'staff', 'field']);
    }

    // ผู้ลงทะเบียนงาน — เลือกเป็น flat collection (มี eventId อ้างอิง) เหมือน boardCards/boardLists
    // ไม่ใช้ subcollection เพราะหน้าแอดมินต้อง query ข้ามอีเวนต์ได้ (เช่นนับผู้ลงทะเบียนรวมทุกงาน)
    // ซึ่งทำกับ subcollection แยกต่อ doc อีเวนต์ลำบากกว่า (ต้อง query ซ้อนหลายชั้นเหมือนเหตุผลของ boardCards)
    // สาธารณะ create ได้ (ลงทะเบียนเองแบบ iftarRegs/volunteerRegs) แต่อ่าน/แก้/ลบเฉพาะ staff
    function validEventReg() {
      let d = request.resource.data;
      return d.keys().hasOnly(['eventId', 'name', 'phone', 'email', 'checkedIn', 'checkedInAt', 'createdAt'])
        && d.eventId is string && d.eventId.size() > 0 && d.eventId.size() <= 100
        && d.name is string && d.name.size() > 0 && d.name.size() <= 100
        && d.phone is string && d.phone.size() > 0 && d.phone.size() <= 20
        && optStr(d, 'email', 200)
        && d.checkedIn is bool && d.checkedIn == false;
    }
    match /eventRegistrations/{id} {
      allow create: if validEventReg();
      allow read, update, delete: if isStaffRole(['admin', 'staff', 'field']);
    }

    // ร้านค้าร่วม campaign — เชื่อม campaignId <-> partnerId (partnerOrganizations ที่ partnerType == 'store')
    match /campaignPartners/{id} {
      allow read, write: if isStaffRole(['admin', 'staff', 'field']);
    }

    // ปฏิเสธทุกอย่างที่ไม่ได้ระบุไว้ข้างบน
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
