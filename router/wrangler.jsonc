{
  "name": "helpme4u-router",
  "main": "worker.js",
  "compatibility_date": "2025-09-01",
  "workers_dev": false,
  "routes": [
    { "pattern": "helpme4u.com", "custom_domain": true },
    { "pattern": "www.helpme4u.com", "custom_domain": true },
    { "pattern": "admin.helpme4u.com", "custom_domain": true },
    { "pattern": "center.helpme4u.com", "custom_domain": true },
    { "pattern": "central.helpme4u.com", "custom_domain": true }
  ],
  "triggers": { "crons": ["* * * * *"] },
  "durable_objects": { "bindings": [{ "name": "PTT", "class_name": "PttHub" }] },
  "migrations": [{ "tag": "ptt-v1", "new_sqlite_classes": ["PttHub"] }]
}
