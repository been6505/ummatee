rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // give2 images — anyone can upload, only admin can delete
    match /give2/{refCode}/{fileName} {
      allow read: if true;
      allow write: if request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null
        && request.auth.token.email == 'ummatee.thailand@gmail.com';
    }
    // deny everything else
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
