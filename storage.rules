rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // ไฟล์สื่อของปฏิทินคอนเทนต์ — admin อัปโหลด ทุกคนเปิดดูผ่านลิงก์ได้
    match /content/{file=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
