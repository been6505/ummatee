// Worker หน้าประชาชน: ummatee-help (Workers Builds จาก branch "cloudflare" ใช้ไฟล์นี้)
// หน้าเว็บอยู่ใน public-site/ ส่วน /api ให้ src/worker.js จัดการ ใช้ D1 ตัวเดียวกับหลังบ้าน
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ummatee-help",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public-site",
    "binding": "ASSETS",
    "run_worker_first": ["/api", "/api/*"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "ummatee-db", "database_id": "2d211589-1846-409f-a0f8-cc352337063a" }
  ],
  "observability": { "enabled": true }
}
