// ตั้งค่า Cloudflare Workers (Workers Builds จาก GitHub branch "cloudflare")
// - หน้าเว็บทั้งหมดเป็น static assets, ส่วน /api ให้ _worker.js จัดการ
// - ฐานข้อมูล D1 ชื่อ ummatee-db ผูกเป็น DB (ไม่ใส่ database_id: wrangler สร้าง/ผูกให้อัตโนมัติตอน deploy)
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ummatee-help",
  "main": "_worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api", "/api/*"],
    "not_found_handling": "none"
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "ummatee-db" }
  ],
  "observability": { "enabled": true }
}
