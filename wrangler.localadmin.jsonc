{ "name": "admin-local", "main": "src/worker.js", "compatibility_date": "2025-09-01", "compatibility_flags": ["nodejs_als"],
  "assets": { "directory": "./admin-site", "binding": "ASSETS", "run_worker_first": ["/api", "/api/*"] },
  "ai": { "binding": "AI" },
